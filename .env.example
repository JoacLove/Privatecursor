# Havian API – fyll inn verdier fra Global Manager → user menu → API
# Ikke commit .env

# Base-URL uten trailing slash, f.eks.:
# https://yourcompany.havian.com/yourCompanyServerKey
HAVIAN_ENDPOINT=https://yourcompany.havian.com/yourCompanyServerKey

# Personlig ApiKey
HAVIAN_API_KEY=

# Server AuthKey (request-header for non-browser)
HAVIAN_AUTH_KEY=

# Header-navn for AuthKey (må være AUTHTOKEN)
HAVIAN_AUTH_HEADER=AUTHTOKEN

# API-versjon
HAVIAN_VERSION=v1
